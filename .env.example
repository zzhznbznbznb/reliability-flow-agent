# LLM 为可选模块。默认关闭，关闭时系统仍然可以完整执行仿真。
RFA_LLM_ENABLED=false

# 复用 OpenCode Go 的 Provider 与认证配置。
# 运行时会从 OpenCode 的本地 auth.json 读取对应 Provider 的 Key，
# 不会把 Key 写入源码、前端或日志。
RFA_LLM_PROVIDER=opencode-go
RFA_LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
RFA_LLM_MODEL=deepseek-v4.1-flash
RFA_LLM_AUTH_MODE=opencode-auth

# 可选：覆盖 OpenCode 认证文件位置。默认位置为
# ~/.local/share/opencode/auth.json
# RFA_OPENCODE_AUTH_FILE=

# 可选：仅在明确需要独立 Key 时使用。请通过安全方式填入，切勿提交到版本库。
# RFA_LLM_API_KEY=
