{
  "schema_version": "process-ir/1.0",
  "name": "设备支援流程",
  "description": "示例：贮存、运输、检测、任务执行与返修流程。只包含业务流程结构，不包含可靠性参数。",
  "status_catalog": [
    {
      "id": "operational",
      "name": "可运行",
      "counts_as_available": true
    },
    {
      "id": "under_repair",
      "name": "维修中",
      "counts_as_available": false
    },
    {
      "id": "retired",
      "name": "已退役",
      "counts_as_available": false
    }
  ],
  "start_node_id": "start",
  "end_node_ids": [
    "end"
  ],
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "name": "开始",
      "description": "设备进入保障流程",
      "position": {
        "x": 40,
        "y": 240
      }
    },
    {
      "id": "storage",
      "type": "task",
      "name": "仓库存储",
      "description": "设备在仓库中等待任务",
      "position": {
        "x": 240,
        "y": 230
      },
      "duration": 2,
      "status_on_enter": "operational"
    },
    {
      "id": "transport",
      "type": "task",
      "name": "设备运输",
      "description": "运输至任务地点",
      "position": {
        "x": 480,
        "y": 230
      },
      "duration": 0.5,
      "status_on_enter": "operational"
    },
    {
      "id": "inspection",
      "type": "task",
      "name": "设备检测",
      "description": "检测设备状态并产生业务结果",
      "position": {
        "x": 720,
        "y": 230
      },
      "duration": 0.2,
      "status_on_enter": "operational",
      "outcomes": [
        {
          "id": "pass",
          "name": "合格",
          "weight": 0.95,
          "attributes": {
            "inspection_passed": true
          }
        },
        {
          "id": "fail",
          "name": "不合格",
          "weight": 0.05,
          "attributes": {
            "inspection_passed": false
          }
        }
      ]
    },
    {
      "id": "inspection_result",
      "type": "decision",
      "name": "检测是否合格",
      "description": "根据检测结果选择任务执行或返修",
      "position": {
        "x": 980,
        "y": 205
      }
    },
    {
      "id": "repair",
      "type": "task",
      "name": "设备维修",
      "description": "维修后返回检测",
      "position": {
        "x": 980,
        "y": 420
      },
      "duration": 1,
      "status_on_enter": "under_repair",
      "status_on_complete": "operational",
      "on_complete": [
        {
          "op": "set_state",
          "name": "currently_failed",
          "value": false
        },
        {
          "op": "increment_counter",
          "name": "repair_count",
          "by": 1
        }
      ]
    },
    {
      "id": "mission",
      "type": "task",
      "name": "执行任务",
      "description": "执行用户定义的任务活动",
      "position": {
        "x": 1250,
        "y": 230
      },
      "duration": 3,
      "status_on_enter": "operational"
    },
    {
      "id": "end",
      "type": "end",
      "name": "任务结束",
      "description": "设备完成本次保障流程",
      "position": {
        "x": 1510,
        "y": 240
      }
    }
  ],
  "edges": [
    {
      "id": "e_start_storage",
      "from": "start",
      "to": "storage",
      "kind": "normal"
    },
    {
      "id": "e_storage_transport",
      "from": "storage",
      "to": "transport",
      "kind": "normal"
    },
    {
      "id": "e_transport_inspection",
      "from": "transport",
      "to": "inspection",
      "kind": "normal"
    },
    {
      "id": "e_inspection_result",
      "from": "inspection",
      "to": "inspection_result",
      "kind": "normal"
    },
    {
      "id": "e_result_mission",
      "from": "inspection_result",
      "to": "mission",
      "kind": "conditional",
      "label": "合格",
      "priority": 10,
      "condition": {
        "op": "eq",
        "field": "attributes.inspection_passed",
        "value": true
      }
    },
    {
      "id": "e_result_repair",
      "from": "inspection_result",
      "to": "repair",
      "kind": "conditional",
      "label": "不合格",
      "priority": 10,
      "condition": {
        "op": "eq",
        "field": "attributes.inspection_passed",
        "value": false
      }
    },
    {
      "id": "e_result_default_repair",
      "from": "inspection_result",
      "to": "repair",
      "kind": "default",
      "label": "未知结果返修",
      "priority": 0
    },
    {
      "id": "e_repair_inspection",
      "from": "repair",
      "to": "inspection",
      "kind": "normal",
      "label": "重新检测"
    },
    {
      "id": "e_mission_end",
      "from": "mission",
      "to": "end",
      "kind": "normal"
    }
  ],
  "guards": {
    "max_node_visits": 10000
  }
}
