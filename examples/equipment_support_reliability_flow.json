{
  "schema_version": "process-ir/1.1",
  "name": "装备保障可靠性仿真流程",
  "description": "贮存与值班两个嵌套阶段配置指数故障率；检测/测试节点使用故障检测率 Ft；普通活动只配置持续时间。值班阶段持续循环，由仿真终止时间结束。",
  "status_catalog": [
    { "id": "operational", "name": "可用", "counts_as_available": true },
    { "id": "under_repair", "name": "维修中", "counts_as_available": false }
  ],
  "start_node_id": "n_start",
  "end_node_ids": ["n_end"],
  "nodes": [
    { "id": "n_start", "type": "start", "name": "开始", "status_on_enter": "operational" },
    {
      "id": "n_storage",
      "type": "subprocess",
      "name": "贮存阶段",
      "description": "嵌套阶段：贮存计时 -> 贮存检测 -> 是否故障；检测到故障则维修并重新开始贮存计时，否则正常退出。",
      "subflow": {
        "start_node_id": "s_start",
        "end_node_ids": ["s_done"],
        "nodes": [
          { "id": "s_start", "type": "start", "name": "贮存开始", "status_on_enter": "operational" },
          {
            "id": "s_store",
            "type": "task",
            "name": "贮存",
            "duration": 30,
            "status_on_enter": "operational",
            "description": "阶段累计时间从本次进入贮存任务开始重新计算。"
          },
          {
            "id": "s_inspect",
            "type": "task",
            "name": "贮存检测",
            "duration": 1,
            "status_on_enter": "operational",
            "description": "测试模块，使用故障检测率 Ft；不配置故障率 λ。"
          },
          { "id": "s_dec", "type": "decision", "name": "贮存检测是否发现故障" },
          {
            "id": "s_repair",
            "type": "task",
            "name": "贮存维修",
            "duration": 2,
            "status_on_enter": "under_repair",
            "status_on_complete": "operational",
            "on_complete": [
              { "op": "set_state", "name": "currently_failed", "value": false }
            ]
          },
          { "id": "s_done", "type": "end", "name": "贮存正常完成", "status_on_enter": "operational" }
        ],
        "edges": [
          { "id": "e_s_start_store", "from": "s_start", "to": "s_store", "kind": "normal" },
          { "id": "e_s_store_inspect", "from": "s_store", "to": "s_inspect", "kind": "normal" },
          { "id": "e_s_inspect_dec", "from": "s_inspect", "to": "s_dec", "kind": "normal" },
          {
            "id": "e_s_dec_repair",
            "from": "s_dec",
            "to": "s_repair",
            "kind": "conditional",
            "priority": 10,
            "label": "检测到故障，维修后重新贮存",
            "condition": { "op": "eq", "field": "test_detected", "value": true }
          },
          {
            "id": "e_s_dec_done",
            "from": "s_dec",
            "to": "s_done",
            "kind": "default",
            "label": "未发现故障，正常退出"
          },
          {
            "id": "e_s_repair_store",
            "from": "s_repair",
            "to": "s_store",
            "kind": "normal",
            "label": "维修后重新开始贮存计时"
          }
        ],
        "guards": { "max_node_visits": 10000 }
      }
    },
    { "id": "n_transport", "type": "task", "name": "运输", "duration": 2, "status_on_enter": "operational" },
    {
      "id": "n_first_test",
      "type": "task",
      "name": "第一次测试",
      "duration": 1,
      "status_on_enter": "operational",
      "description": "测试模块，使用故障检测率 Ft；不配置故障率 λ。"
    },
    { "id": "n_dec_first_test", "type": "decision", "name": "第一次测试是否发现故障" },
    {
      "id": "n_repair",
      "type": "task",
      "name": "维修",
      "duration": 2,
      "status_on_enter": "under_repair",
      "status_on_complete": "operational",
      "on_complete": [
        { "op": "set_state", "name": "currently_failed", "value": false }
      ]
    },
    { "id": "n_short_transport", "type": "task", "name": "第二次运输", "duration": 1, "status_on_enter": "operational" },
    { "id": "n_load_ship", "type": "task", "name": "装舰", "duration": 1, "status_on_enter": "operational" },
    {
      "id": "n_second_test",
      "type": "task",
      "name": "第二次测试",
      "duration": 1,
      "status_on_enter": "operational",
      "description": "测试模块，使用故障检测率 Ft；不配置故障率 λ。"
    },
    { "id": "n_dec_second_test", "type": "decision", "name": "第二次测试是否发现故障" },
    { "id": "n_exit_duty", "type": "task", "name": "下舰准备", "duration": 1, "status_on_enter": "operational" },
    { "id": "n_disembark", "type": "task", "name": "下舰", "duration": 1, "status_on_enter": "operational" },
    {
      "id": "n_shore_repair",
      "type": "task",
      "name": "岸上维修",
      "duration": 3,
      "status_on_enter": "under_repair",
      "status_on_complete": "operational",
      "on_complete": [
        { "op": "set_state", "name": "currently_failed", "value": false }
      ]
    },
    {
      "id": "n_duty",
      "type": "subprocess",
      "name": "值班阶段",
      "description": "嵌套阶段：值班计时 -> 值班检测 -> 是否故障；检测到故障则维修并返回值班，正常则继续下一轮值班。",
      "subflow": {
        "start_node_id": "d_start",
        "end_node_ids": ["d_done"],
        "nodes": [
          { "id": "d_start", "type": "start", "name": "值班开始", "status_on_enter": "operational" },
          {
            "id": "d_duty",
            "type": "task",
            "name": "值班",
            "duration": 5,
            "status_on_enter": "operational",
            "description": "阶段累计时间从本次进入值班任务开始重新计算。"
          },
          {
            "id": "d_inspect",
            "type": "task",
            "name": "值班检测",
            "duration": 1,
            "status_on_enter": "operational",
            "description": "测试模块，使用故障检测率 Ft；不配置故障率 λ。"
          },
          { "id": "d_dec", "type": "decision", "name": "值班检测是否发现故障" },
          {
            "id": "d_repair",
            "type": "task",
            "name": "值班维修",
            "duration": 2,
            "status_on_enter": "under_repair",
            "status_on_complete": "operational",
            "on_complete": [
              { "op": "set_state", "name": "currently_failed", "value": false }
            ]
          },
          { "id": "d_loop", "type": "decision", "name": "继续下一轮值班" },
          { "id": "d_done", "type": "end", "name": "值班结构出口", "status_on_enter": "operational" }
        ],
        "edges": [
          { "id": "e_d_start_duty", "from": "d_start", "to": "d_duty", "kind": "normal" },
          { "id": "e_d_duty_inspect", "from": "d_duty", "to": "d_inspect", "kind": "normal" },
          { "id": "e_d_inspect_dec", "from": "d_inspect", "to": "d_dec", "kind": "normal" },
          {
            "id": "e_d_dec_repair",
            "from": "d_dec",
            "to": "d_repair",
            "kind": "conditional",
            "priority": 10,
            "label": "检测到故障，维修后返回值班",
            "condition": { "op": "eq", "field": "test_detected", "value": true }
          },
          {
            "id": "e_d_dec_loop",
            "from": "d_dec",
            "to": "d_loop",
            "kind": "default",
            "label": "未发现故障，继续下一轮"
          },
          { "id": "e_d_repair_duty", "from": "d_repair", "to": "d_duty", "kind": "normal" },
          {
            "id": "e_d_loop_duty",
            "from": "d_loop",
            "to": "d_duty",
            "kind": "conditional",
            "priority": 10,
            "label": "继续值班",
            "condition": { "op": "lt", "field": "node_visits.d_duty", "value": 1000000 }
          },
          {
            "id": "e_d_loop_done",
            "from": "d_loop",
            "to": "d_done",
            "kind": "default",
            "label": "结构出口（正常运行不会到达）"
          }
        ],
        "guards": { "max_node_visits": 1000000 }
      }
    },
    { "id": "n_end", "type": "end", "name": "结束", "status_on_enter": "operational" }
  ],
  "edges": [
    { "id": "e_start_storage", "from": "n_start", "to": "n_storage", "kind": "normal" },
    {
      "id": "e_storage_transport",
      "from": "n_storage",
      "to": "n_transport",
      "kind": "normal",
      "subflow_exit": "s_done"
    },
    { "id": "e_transport_test1", "from": "n_transport", "to": "n_first_test", "kind": "normal" },
    { "id": "e_test1_dec", "from": "n_first_test", "to": "n_dec_first_test", "kind": "normal" },
    {
      "id": "e_test1_repair",
      "from": "n_dec_first_test",
      "to": "n_repair",
      "kind": "conditional",
      "priority": 10,
      "label": "检测到故障，维修后返回第一次测试",
      "condition": { "op": "eq", "field": "test_detected", "value": true }
    },
    {
      "id": "e_test1_normal",
      "from": "n_dec_first_test",
      "to": "n_short_transport",
      "kind": "default",
      "label": "未发现故障"
    },
    { "id": "e_repair_test1", "from": "n_repair", "to": "n_first_test", "kind": "normal" },
    { "id": "e_short_load", "from": "n_short_transport", "to": "n_load_ship", "kind": "normal" },
    { "id": "e_load_test2", "from": "n_load_ship", "to": "n_second_test", "kind": "normal" },
    { "id": "e_test2_dec", "from": "n_second_test", "to": "n_dec_second_test", "kind": "normal" },
    {
      "id": "e_test2_abnormal",
      "from": "n_dec_second_test",
      "to": "n_exit_duty",
      "kind": "conditional",
      "priority": 10,
      "label": "检测到故障，下舰维修后返回第二次测试",
      "condition": { "op": "eq", "field": "test_detected", "value": true }
    },
    {
      "id": "e_test2_normal",
      "from": "n_dec_second_test",
      "to": "n_duty",
      "kind": "default",
      "label": "未发现故障，进入值班"
    },
    { "id": "e_exit_unload", "from": "n_exit_duty", "to": "n_disembark", "kind": "normal" },
    { "id": "e_unload_shore", "from": "n_disembark", "to": "n_shore_repair", "kind": "normal" },
    { "id": "e_shore_test2", "from": "n_shore_repair", "to": "n_second_test", "kind": "normal" },
    {
      "id": "e_duty_end",
      "from": "n_duty",
      "to": "n_end",
      "kind": "normal",
      "subflow_exit": "d_done"
    }
  ],
  "guards": { "max_node_visits": 1000000 }
}
