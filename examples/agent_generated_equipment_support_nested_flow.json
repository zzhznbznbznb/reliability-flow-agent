{
  "description": "装备保障业务：贮存子流程经运输、阵地/测试场与两次测试后进入值班子流程。贮存检测、第一次测试、第二次测试、值班检测的故障概率未给出，检测/测试任务的故障/无故障结果权重为占位值，待可靠性配置确认。",
  "end_node_ids": [
    "shore_end",
    "root_end"
  ],
  "edges": [
    {
      "from": "root_start",
      "id": "e_root_start_storage",
      "kind": "normal",
      "label": "开始",
      "to": "storage"
    },
    {
      "from": "storage",
      "id": "e_storage_transport",
      "kind": "normal",
      "label": "贮存正常结束后进入运输",
      "subflow_exit": "sto_end",
      "to": "transport"
    },
    {
      "from": "transport",
      "id": "e_transport_staging",
      "kind": "normal",
      "label": "运输2天后进入阵地/测试场",
      "to": "staging"
    },
    {
      "from": "staging",
      "id": "e_staging_test1",
      "kind": "normal",
      "label": "进入第一次测试",
      "to": "test1"
    },
    {
      "from": "test1",
      "id": "e_test1_fault",
      "kind": "normal",
      "label": "第一次测试后判断",
      "to": "test1_fault"
    },
    {
      "condition": {
        "field": "attributes.fault",
        "op": "eq",
        "value": true
      },
      "from": "test1_fault",
      "id": "e_test1_fault_yes",
      "kind": "conditional",
      "label": "第一次测试故障",
      "to": "repair1"
    },
    {
      "from": "test1_fault",
      "id": "e_test1_fault_no",
      "kind": "default",
      "label": "第一次测试无故障",
      "to": "short_haul"
    },
    {
      "from": "repair1",
      "id": "e_repair1_retest",
      "kind": "normal",
      "label": "维修2天后返回第一次测试",
      "to": "test1"
    },
    {
      "from": "short_haul",
      "id": "e_short_haul_ship_load",
      "kind": "normal",
      "label": "短途运输后装舰",
      "to": "ship_load"
    },
    {
      "from": "ship_load",
      "id": "e_ship_load_test2",
      "kind": "normal",
      "label": "装舰后第二次测试",
      "to": "test2"
    },
    {
      "from": "test2",
      "id": "e_test2_fault",
      "kind": "normal",
      "label": "第二次测试后判断",
      "to": "test2_fault"
    },
    {
      "condition": {
        "field": "attributes.fault",
        "op": "eq",
        "value": true
      },
      "from": "test2_fault",
      "id": "e_test2_fault_yes",
      "kind": "conditional",
      "label": "第二次测试故障",
      "to": "off_duty"
    },
    {
      "from": "test2_fault",
      "id": "e_test2_fault_no",
      "kind": "default",
      "label": "第二次测试无故障",
      "to": "duty"
    },
    {
      "from": "off_duty",
      "id": "e_off_duty_off_ship",
      "kind": "normal",
      "label": "出值班后下舰",
      "to": "off_ship"
    },
    {
      "from": "off_ship",
      "id": "e_off_ship_shore_repair",
      "kind": "normal",
      "label": "下舰后岸上维修",
      "to": "shore_repair"
    },
    {
      "from": "shore_repair",
      "id": "e_shore_repair_end",
      "kind": "normal",
      "label": "岸上维修3天后结束",
      "to": "shore_end"
    },
    {
      "from": "duty",
      "id": "e_duty_root_end",
      "kind": "normal",
      "label": "值班正常结束后流程结束",
      "subflow_exit": "duty_end",
      "to": "root_end"
    }
